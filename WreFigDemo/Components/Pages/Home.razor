@page "/"
@attribute [Authorize]
@inject IBranchService BranchSvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject NoteViewStateService NoteViewState

<PageTitle>WRE FIG — All Field Offices</PageTitle>

@if (Loading)
{
    <div class="loading">Loading…</div>
}
else
{
    <div class="branch-home-header">
        <div class="branch-home-title">@DashboardTitle</div>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
            <input class="branch-search" type="text"
                   placeholder="Search branches…"
                   @bind="SearchText" @bind:event="oninput" />
            <button class="btn btn-ghost btn-sm refresh-btn" title="Refresh" @onclick="LoadAsync">&#8635;</button>
        </div>
    </div>

    @* Month selector *@
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap">
        <span style="font-size:12px;color:var(--ink-faint);font-weight:600;text-transform:uppercase;letter-spacing:0.04em">Month:</span>
        <div class="month-tab-nav">
            <button class="month-nav-btn" @onclick="PrevMonth">&#8249;</button>
            <button class="month-tab @(IsViewingCurrentMonth ? "active" : "")" @onclick="GoToCurrentMonth">This Month</button>
            <button class="month-tab @(IsViewingNextMonth ? "active" : "")"    @onclick="GoToNextMonth">Next Month</button>
            <button class="month-nav-btn" disabled="@(!CanGoForward)" @onclick="NextMonth"
                    style="@(!CanGoForward ? "opacity:0.3;cursor:default" : "")">&#8250;</button>
        </div>
        @if (!IsViewingCurrentMonth && !IsViewingNextMonth)
        {
            <span class="month-label-aside">@MonthLabel</span>
        }
    </div>

    @if (!GroupedBranches.Any())
    {
        <div class="region-section last-region" style="text-align:center;padding:30px">
            <span style="color:var(--ink-faint);font-style:italic">No field offices match your search.</span>
        </div>
    }
    else
    {
        @foreach (var (region, idx, branches) in GroupedBranches)
        {
            var isLast = idx == GroupedBranches.Count - 1;
            var attentionCount = branches.Count(b => b.Status != "green");
            <div class="region-section @(isLast ? "last-region" : "")">
                <div class="region-header">
                    <span class="region-name">@region · @branches.Count field office@(branches.Count == 1 ? "" : "s")</span>
                    <span class="region-attn @(attentionCount > 0 ? "alert" : "")">
                        @(attentionCount == 0 ? "All up to date" : $"{attentionCount} need{(attentionCount == 1 ? "s" : "")} attention")
                    </span>
                </div>
                <div class="branch-grid">
                    @foreach (var b in branches)
                    {
                        <BranchCard Summary="b"
                                    IsPinned="PinnedIds.Contains(b.BranchId)"
                                    HasUnviewedNotes="b.HasNotes && !NoteViewState.IsBranchViewed(b.BranchId)"
                                    OnClick="() => GoToSchedule(b.BranchId)"
                                    OnTogglePin="TogglePin" />
                    }
                </div>
            </div>
        }
    }

    <div class="branch-home-footer">
        <span>Showing @FilteredBranches.Count of @Branches.Count · click a field office to open schedule</span>
        <span style="color:var(--ink-faint)">@MonthLabel fill rates</span>
    </div>
}

@code {
    private List<BranchSummaryVm> Branches      = [];
    private string  SearchText                  = string.Empty;
    private bool    Loading                     = true;
    private int     Year                        = DateTime.Now.Year;
    private int     Month                       = DateTime.Now.Month;
    private string? UserId;
    private string? UserName;
    private string? UserRole;
    private bool    IsGlobalView                = true;

    private string DashboardTitle => UserRole switch
    {
        AppRoles.PlannerDashboard   => "Planner Dashboard",
        AppRoles.FieldSupervisor    => "Field Supervisor Dashboard",
        AppRoles.DispatchSupervisor => "Dispatch Supervisor Dashboard",
        _                           => "Read Only Dashboard"
    };

    private HashSet<int> PinnedIds                = [];
    private static readonly string[] RegionOrder = ["Mid-Atlantic", "Mid-South", "South", "North"];

    private string MonthLabel => new DateTime(Year, Month, 1).ToString("MMMM yyyy");

    private static int  _nowYear  => DateTime.Now.Year;
    private static int  _nowMonth => DateTime.Now.Month;
    private (int Y, int M) NextMonthDate => _nowMonth == 12 ? (_nowYear + 1, 1) : (_nowYear, _nowMonth + 1);

    private bool IsViewingCurrentMonth => Year == _nowYear  && Month == _nowMonth;
    private bool IsViewingNextMonth    => Year == NextMonthDate.Y && Month == NextMonthDate.M;
    private bool CanGoForward          => !IsViewingNextMonth;

    private List<BranchSummaryVm> FilteredBranches =>
        string.IsNullOrWhiteSpace(SearchText)
            ? Branches
            : Branches.Where(b =>
                b.BranchName.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                b.City.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                b.State.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                b.RegionName.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
              .ToList();

    private List<(string Region, int Idx, List<BranchSummaryVm> Branches)> GroupedBranches
    {
        get
        {
            var grouped = FilteredBranches
                .GroupBy(b => b.RegionName)
                .ToDictionary(g => g.Key, g => g.ToList());

            var ordered = RegionOrder
                .Where(r => grouped.ContainsKey(r))
                .Select(r => grouped[r])
                .ToList();

            // Append any regions not in the standard order
            foreach (var kvp in grouped)
                if (!RegionOrder.Contains(kvp.Key))
                    ordered.Add(kvp.Value);

            return ordered.Select((list, i) => (list.First().RegionName, i, list)).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        UserId   = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        UserName = auth.User.Identity?.Name ?? "User";
        UserRole = AppRoles.All.FirstOrDefault(r => auth.User.IsInRole(r));
        IsGlobalView = AppRoles.GlobalViewRoles.Any(r => auth.User.IsInRole(r));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading  = true;
        Branches = await BranchSvc.GetBranchSummariesAsync(Year, Month, UserId);
        Loading  = false;
    }

    private async Task PrevMonth()
    {
        Month--;
        if (Month < 1) { Month = 12; Year--; }
        await LoadAsync();
    }

    private async Task NextMonth()
    {
        if (!CanGoForward) return;
        Month++;
        if (Month > 12) { Month = 1; Year++; }
        await LoadAsync();
    }

    private async Task GoToCurrentMonth()
    {
        Year  = _nowYear;
        Month = _nowMonth;
        await LoadAsync();
    }

    private async Task GoToNextMonth()
    {
        (Year, Month) = NextMonthDate;
        await LoadAsync();
    }

    private void TogglePin(int branchId)
    {
        if (!PinnedIds.Add(branchId))
            PinnedIds.Remove(branchId);
    }

    private void GoToSchedule(int branchId)
    {
        NoteViewState.MarkBranchViewed(branchId);
        Nav.NavigateTo($"/schedule/{branchId}?year={Year}&month={Month}");
    }
}
