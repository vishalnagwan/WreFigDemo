@page "/schedule/{BranchId:int}"
@attribute [Authorize]
@using WreFigDemo.Models.Entities
@using WreFigDemo.Models
@inject IScheduleService ScheduleSvc
@inject IBranchService BranchSvc
@inject IAuditService AuditSvc
@inject IStatusCodeService StatusCodeSvc
@inject IBranchInstructionService InstructionSvc
@inject NoteViewStateService NoteViewState
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Schedule — @(Summary?.BranchName ?? "Branch")</PageTitle>

@if (Loading)
{
    <div class="loading">Loading…</div>
}
else if (Grid is not null)
{
    @* Header *@
    <div class="page-header">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <button class="btn btn-ghost btn-sm" @onclick='() => Nav.NavigateTo("/")'>&#8592; All field offices</button>
            <h1 class="page-title">@Summary?.BranchName</h1>
            @if (Summary is not null)
            {
                <span class="branch-status-pill @Summary.Status" style="font-size:11px">
                    @(Summary.Status == "green" ? "Up to date" : Summary.Status == "amber" ? "Stale" : "Needs attention")
                </span>
            }
        </div>
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            @if (UnreadAlerts > 0)
            {
                <div class="alerts-bell-wrap" title="View change alerts" @onclick='() => Nav.NavigateTo("/alerts")'>
                    <span style="font-size:20px">&#128276;</span>
                    <span class="alerts-badge">@UnreadAlerts</span>
                </div>
            }
            <div class="month-tab-nav">
                <button class="month-nav-btn" @onclick="PrevMonth">&#8249;</button>
                <button class="month-tab @(IsViewingCurrentMonth ? "active" : "")" @onclick="GoToCurrentMonth">This Month</button>
                <button class="month-tab @(IsViewingNextMonth ? "active" : "")"    @onclick="GoToNextMonth">Next Month</button>
                <button class="month-nav-btn" disabled="@(!CanGoForward)" @onclick="NextMonth"
                        style="@(!CanGoForward ? "opacity:0.3;cursor:default" : "")">&#8250;</button>
            </div>
            @if (!IsViewingCurrentMonth && !IsViewingNextMonth)
            {
                <span class="month-label-aside">@MonthLabel</span>
            }
        </div>
    </div>

    @* Top branch instructions — above fill bar and apply status *@
    <BranchInstructions @ref="_topInstructions"
                        BranchId="BranchId"
                        Position="InstructionPosition.Top"
                        CanEdit="CanInstructionEdit"
                        OnEditRequested="OpenInstructionEditor" />

    @* Fill bar *@
    @if (Summary is not null)
    {
        <div class="fill-bar-container">
            <FillBar Pct="@((int)Summary.FillRate)" />
        </div>
    }

    @* Paint mode toolbar *@
    @if (CanEdit)
    {
        <div class="paint-toolbar">
            <span class="paint-toolbar-label">Apply status:</span>
            @foreach (var chip in PaintBarCodes)
            {
                <span class="paint-chip @chip.CssClass @(PaintMode == chip.Code ? "active" : "")"
                      @onclick="() => TogglePaint(chip.Code)">
                    @chip.Label
                </span>
            }
            <span class="paint-chip clear @(PaintMode == "clear" ? "active" : "")"
                  @onclick='() => TogglePaint("clear")'>Clear</span>
            @if (PaintMode is not null)
            {
                <span class="paint-loaded-center">
                    <span class="pulse"></span>
                    <strong>@(PaintMode == "clear" ? "Clear" : StatusCodeSvc.GetLabel(PaintMode))</strong> loaded
                    @if (SelectedRows.Count > 1)
                    {
                        <span> · <strong>@SelectedRows.Count rows selected</strong></span>
                    }
                </span>
                <span class="paint-help-right">Click cells to apply · Esc to exit</span>
            }
            else
            {
                <span class="paint-help-right">Click a status to start assignment · select rows for bulk assignment</span>
            }
        </div>
    }

    @* Grid *@
    <div class="schedule-scroll-wrap">
        <table class="schedule-table">
            <thead>
                <tr>
                    @if (CanEdit)
                    {
                        <th class="row-check-col">
                            <span class="row-check @(SelectedRows.Count == Grid.Employees.Count && Grid.Employees.Count > 0 ? "checked" : "")"
                                  @onclick="ToggleAllRows" title="Select all"></span>
                        </th>
                    }
                    <th class="emp-col">Employee</th>
                    <th class="shift-col">Shift</th>
                    @foreach (var d in Grid.Days)
                    {
                        <th class="day-col @(d.IsWeekend ? "weekend" : "")">
                            @d.DayAbbr @d.Day
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Grid.Employees.Any())
                {
                    <tr>
                        <td colspan="@(33 + (CanEdit ? 1 : 0))" class="empty-state">
                            No employees configured for this field office yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Grid.Employees)
                    {
                        var isSelected = SelectedRows.Contains(row.EmployeeId);
                        <tr class="@(isSelected ? "row-selected" : "")">
                            @if (CanEdit)
                            {
                                <td class="row-check-col">
                                    <span class="row-check @(isSelected ? "checked" : "")"
                                          @onclick="() => ToggleRow(row.EmployeeId)"
                                          @onclick:stopPropagation="true"
                                          title="@(isSelected ? "Deselect row" : "Select row for bulk paint")"></span>
                                </td>
                            }
                            <td class="emp-col" style="font-weight:600">@row.EmployeeName</td>
                            <td class="shift-col">
                                <span class="shift-badge @(row.DefaultShift == "PM" ? "pm" : "")">
                                    @row.DefaultShift
                                </span>
                            </td>
                            @foreach (var d in Grid.Days)
                            {
                                var cell    = row.Cells[d.Day];
                                var key     = $"{row.EmployeeId}-{d.Day}";
                                var just    = JustPainted.Contains(key);
                                var noteDate = new DateOnly(SafeYear, SafeMonth, d.Day);
                                var unviewed = cell.HasNote && !NoteViewState.IsCellViewed(row.EmployeeId, noteDate);
                                <td class="day-col @(d.IsWeekend ? "weekend" : "") @(unviewed ? "note-alert" : "")"
                                    @onclick="() => HandleCellClick(row, d.Day, cell)">
                                    <ShiftChip Code="@cell.StatusCode"
                                               HasNote="@unviewed"
                                               JustPainted="@just" />
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* Bottom dispatch/logistics notes — below the grid, sibling not wrapper *@
    <div style="margin-top:8px">
        <BranchInstructions @ref="_bottomInstructions"
                            BranchId="BranchId"
                            Position="InstructionPosition.Bottom"
                            CanEdit="CanInstructionEdit"
                            OnEditRequested="OpenInstructionEditor" />
    </div>

    @* Instruction editor overlay *@
    @if (_instructionEditorOpen && _instructionVm is not null)
    {
        <BranchInstructionEditor Vm="_instructionVm"
                                 BranchName="@(Summary?.BranchName ?? string.Empty)"
                                 UserId="@UserId"
                                 UserName="@UserName"
                                 OnSaved="HandleInstructionSaved"
                                 OnClose="CloseInstructionEditor" />
    }

    @* Legend *@
    <div class="legend">
        <div class="legend-item"><span class="legend-swatch" style="background:var(--purple-am);border-color:var(--purple-am-border)"></span>WA - Working AM</div>
        <div class="legend-item"><span class="legend-swatch" style="background:var(--pink-pm);border-color:var(--pink-pm-border)"></span>WP - Working PM</div>
        <div class="legend-item"><span class="legend-swatch" style="background:var(--blackout-bg);border-color:var(--blackout-border)"></span><span style="color:var(--ink-light)">O - PTO</span></div>
        <div class="legend-item"><span class="legend-swatch" style="background:var(--callout-bg);border-color:var(--callout-border)"></span>CO - Call-out</div>
        <div class="legend-item"><span class="legend-swatch" style="background:var(--oncall-bg);border-color:var(--oncall-border)"></span>OC - On-call</div>
        <div class="legend-item"><span class="legend-swatch" style="background:var(--training-bg);border-color:var(--training-border)"></span>TR - Training</div>
        <div class="legend-item"><span class="legend-swatch" style="background:var(--holiday-bg);border-color:var(--holiday-border)"></span>HD - Holiday</div>
        <div class="legend-item"><span class="legend-swatch" style="background:var(--weather-bg);border-color:var(--weather-border)"></span>WX - Weather</div>
        <div class="legend-item" style="margin-left:auto"><span style="color:var(--note-dot);font-size:10px">●</span>&nbsp;has note</div>
    </div>

    @* Day detail panel *@
    @if (DetailRow is not null)
    {
        <DayDetailPanel Row="DetailRow" Day="DetailDay" Cell="DetailCell"
                        Year="Year" Month="Month" BranchId="BranchId"
                        CanEdit="CanEdit" CanNote="CanNote"
                        UserId="UserId" UserName="UserName"
                        OnClose="CloseDetail" />
    }
}

@code {
    [Parameter] public int BranchId { get; set; }
    [SupplyParameterFromQuery] public int Year  { get; set; } = DateTime.Now.Year;
    [SupplyParameterFromQuery] public int Month { get; set; } = DateTime.Now.Month;

    private ScheduleGridVm?  Grid;
    private BranchSummaryVm? Summary;
    private bool             Loading           = true;
    private bool             CanEdit;            // can paint / change status codes
    private bool             CanNote;            // can add / edit supervisor notes
    private bool             CanInstructionEdit; // can add / edit branch instructions
    private string?          UserId;
    private string?          UserName;
    private int              UnreadAlerts;

    // Instruction editor state
    private BranchInstructions?    _topInstructions;
    private BranchInstructions?    _bottomInstructions;
    private bool                   _instructionEditorOpen;
    private BranchInstructionsVm?  _instructionVm;

    private EmployeeScheduleRow? DetailRow;
    private int                  DetailDay;
    private DayCell?             DetailCell;

    private string? PaintMode;
    private HashSet<int> SelectedRows = [];
    private HashSet<string> JustPainted = [];
    private List<ScheduleStatusCode> PaintBarCodes = [];

    // [SupplyParameterFromQuery] params can be 0 during Blazor's parameter-set cycle — guard them.
    private int SafeYear  => Year  > 0              ? Year  : DateTime.Now.Year;
    private int SafeMonth => Month is >= 1 and <= 12 ? Month : DateTime.Now.Month;

    private string MonthLabel => new DateTime(SafeYear, SafeMonth, 1).ToString("MMMM yyyy");

    private static int  _nowYear  => DateTime.Now.Year;
    private static int  _nowMonth => DateTime.Now.Month;
    private (int Y, int M) NextMonthDate => _nowMonth == 12 ? (_nowYear + 1, 1) : (_nowYear, _nowMonth + 1);

    private bool IsViewingCurrentMonth => SafeYear == _nowYear  && SafeMonth == _nowMonth;
    private bool IsViewingNextMonth    => SafeYear == NextMonthDate.Y && SafeMonth == NextMonthDate.M;
    private bool CanGoForward          => !IsViewingNextMonth;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        UserId   = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        UserName = auth.User.FindFirst("fullname")?.Value
                ?? auth.User.Identity?.Name
                ?? string.Empty;
        CanEdit           = AppRoles.WriteRoles.Any(r => auth.User.IsInRole(r));
        CanNote           = AppRoles.NoteRoles.Any(r => auth.User.IsInRole(r));
        CanInstructionEdit = AppRoles.InstructionEditRoles.Any(r => auth.User.IsInRole(r));
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("registerEscKey", DotNetObjectReference.Create(this));

            // Restore viewed-cell state from localStorage so bell icons stay cleared
            // after logout/re-login (JS interop only available post-render).
            if (UserId is not null)
            {
                try
                {
                    var cellKeys = await JS.InvokeAsync<string[]>("wreGetViewedCells", UserId);
                    bool changed = false;
                    foreach (var key in cellKeys)
                    {
                        // Key format: "{employeeId}:{yyyy-MM-dd}"
                        var sep = key.IndexOf(':');
                        if (sep > 0
                            && int.TryParse(key[..sep], out var empId)
                            && DateOnly.TryParse(key[(sep + 1)..], out var date)
                            && !NoteViewState.IsCellViewed(empId, date))
                        {
                            NoteViewState.MarkCellViewed(empId, date);
                            changed = true;
                        }
                    }
                    if (changed) StateHasChanged();
                }
                catch { /* localStorage unavailable — degrade gracefully */ }
            }
        }
    }

    [JSInvokable]
    public void OnEscapeKey()
    {
        PaintMode = null;
        SelectedRows.Clear();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        var allCodes = await StatusCodeSvc.GetAllAsync();
        PaintBarCodes = allCodes.Where(s => s.ShowInPaintBar).ToList();
        Grid    = await ScheduleSvc.GetGridAsync(BranchId, Year, Month);
        Summary = await BranchSvc.GetBranchSummaryAsync(BranchId, Year, Month);
        var alerts = await AuditSvc.GetRecentAlertsAsync(branchId: BranchId, count: 50);
        UnreadAlerts = alerts.Count(a => a.IsUnread);
        Loading = false;
    }

    private async Task PrevMonth()
    {
        Month--;
        if (Month < 1) { Month = 12; Year--; }
        Nav.NavigateTo($"/schedule/{BranchId}?year={Year}&month={Month}", replace: true);
        await LoadAsync();
    }

    private async Task NextMonth()
    {
        if (!CanGoForward) return;
        Month++;
        if (Month > 12) { Month = 1; Year++; }
        Nav.NavigateTo($"/schedule/{BranchId}?year={Year}&month={Month}", replace: true);
        await LoadAsync();
    }

    private async Task GoToCurrentMonth()
    {
        Year  = _nowYear;
        Month = _nowMonth;
        Nav.NavigateTo($"/schedule/{BranchId}?year={Year}&month={Month}", replace: true);
        await LoadAsync();
    }

    private async Task GoToNextMonth()
    {
        (Year, Month) = NextMonthDate;
        Nav.NavigateTo($"/schedule/{BranchId}?year={Year}&month={Month}", replace: true);
        await LoadAsync();
    }

    private void TogglePaint(string code)
    {
        PaintMode = PaintMode == code ? null : code;
    }

    private void ToggleRow(int employeeId)
    {
        if (!SelectedRows.Add(employeeId))
            SelectedRows.Remove(employeeId);
    }

    private void ToggleAllRows()
    {
        if (Grid is null) return;
        if (SelectedRows.Count == Grid.Employees.Count)
            SelectedRows.Clear();
        else
            SelectedRows = Grid.Employees.Select(e => e.EmployeeId).ToHashSet();
    }

    private void HandleCellClick(EmployeeScheduleRow row, int day, DayCell cell)
    {
        if (PaintMode is null)
        {
            OpenDetail(row, day, cell);
            return;
        }

        var targets = SelectedRows.Count > 1 && SelectedRows.Contains(row.EmployeeId)
            ? SelectedRows.ToList()
            : [row.EmployeeId];

        foreach (var empId in targets)
        {
            var targetRow = Grid!.Employees.FirstOrDefault(e => e.EmployeeId == empId);
            if (targetRow is null) continue;

            var targetCell = targetRow.Cells[day];
            var newCode = PaintMode == "clear" ? "—" : PaintMode;
            targetCell.StatusCode = newCode;

            var key = $"{empId}-{day}";
            JustPainted.Add(key);
            _ = ClearPaintFlashAsync(key);

            _ = PersistCellAsync(empId, day, newCode);
        }
    }

    private async Task PersistCellAsync(int empId, int day, string code)
    {
        if (UserId is null) return;
        var date = new DateOnly(SafeYear, SafeMonth, day);
        await ScheduleSvc.UpsertCellAsync(empId, date, code, UserId, UserName!);
    }

    private async Task ClearPaintFlashAsync(string key)
    {
        await Task.Delay(700);
        JustPainted.Remove(key);
        StateHasChanged();
    }

    private void OpenDetail(EmployeeScheduleRow row, int day, DayCell cell)
    {
        DetailRow  = row;
        DetailDay  = day;
        DetailCell = cell;

        // Mark noted cell as viewed so the amber glow AND bell chip clear immediately.
        // StateHasChanged() is called explicitly so the grid re-renders before the panel
        // overlay appears — the bell is already gone by the time the panel slides in.
        // Also persist to localStorage so the bell stays cleared after logout/re-login.
        if (cell.HasNote)
        {
            var noteDate = new DateOnly(SafeYear, SafeMonth, day);
            NoteViewState.MarkCellViewed(row.EmployeeId, noteDate);
            if (UserId is not null)
                _ = JS.InvokeVoidAsync("wreSetViewedCell", UserId,
                        $"{row.EmployeeId}:{noteDate:yyyy-MM-dd}").AsTask();
            StateHasChanged();
        }
    }

    private void CloseDetail()
    {
        DetailRow  = null;
        DetailCell = null;
    }

    // ── Instruction editor ────────────────────────────────────────────────────

    private async Task OpenInstructionEditor()
    {
        _instructionVm         = await InstructionSvc.GetForBranchAsync(BranchId);
        _instructionEditorOpen = true;
    }

    private void CloseInstructionEditor()
    {
        _instructionEditorOpen = false;
        _instructionVm         = null;
    }

    private async Task HandleInstructionSaved()
    {
        _instructionEditorOpen = false;
        _instructionVm         = null;
        if (_topInstructions    is not null) await _topInstructions.ReloadAsync();
        if (_bottomInstructions is not null) await _bottomInstructions.ReloadAsync();
    }

}
