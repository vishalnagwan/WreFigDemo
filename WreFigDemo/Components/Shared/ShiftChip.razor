@* Shift status chip — maps status code to wireframe colors *@

@{
    var cls = Code?.ToLower() switch {
        "wa"  => "wa",
        "wp"  => "wp",
        "pto" => "pto",
        "co"  => "co",
        "oc"  => "oc",
        "tr"  => "tr",
        _     => "empty"
    };
    var label = Code?.ToUpper() switch {
        "WA"  => "WA",
        "WP"  => "WP",
        "PTO" => "PTO",
        "CO"  => "CO",
        "OC"  => "OC",
        "TR"  => "TR",
        _     => "—"
    };
}

<div class="shift-chip @cls @(JustPainted ? "just-painted" : "")"
     title="@(HasNote ? "Has supervisor note" : null)">
    @label
    @if (HasNote)
    {
        <span class="note-dot"></span>
    }
</div>

@code {
    [Parameter] public string? Code        { get; set; }
    [Parameter] public bool    HasNote     { get; set; }
    [Parameter] public bool    JustPainted { get; set; }
}
