@*
    Chip-strip + inline popover for branch instructions.
    When AllPositions=true (default for the top slot) all sections from both
    Top and Bottom positions are shown in one unified chip strip.
    When AllPositions=false the component filters to Position only.
*@
@using WreFigDemo.Models
@using WreFigDemo.Models.Entities
@using WreFigDemo.Models.ViewModels
@inject IBranchInstructionService InstructionSvc
@inject BranchInstructionBroadcastService Broadcast
@implements IDisposable

@* Live-update banner *@
@if (_notifyBanner is not null)
{
    <div class="instr-notify-bar">
        <span>⚡</span>
        <span>Instructions updated by <strong>@_notifyBanner</strong> — refreshed</span>
        <button @onclick="DismissBanner">✕</button>
    </div>
}

@if (_sections is not null)
{
    var withContent = _sections.Where(s => s.HasContent).OrderBy(s => s.SectionTitle).ToList();

    @if (withContent.Any() || CanEdit)
    {
        <div class="instr-chip-bar">
            <div class="instr-chip-strip">
                @foreach (var sec in withContent)
                {
                    var s = sec;
                    <button class="instr-chip @(s.HasUrgent ? "has-urgent" : "") @(_openKey == s.SectionKey ? "active" : "")"
                            @onclick="() => ToggleSection(s.SectionKey)">
                        @if (s.HasUrgent)
                        {
                            <span class="instr-chip-dot"></span>
                        }
                        @s.ShortTitle
                        <span class="instr-chip-count">@s.ActiveLineCount</span>
                    </button>
                }
                @if (!withContent.Any())
                {
                    <span class="instr-chip-empty">No instructions added yet</span>
                }
            </div>
            <div class="instr-chip-actions">
                @if (withContent.Any())
                {
                    <span class="instr-section-badge">
                        @withContent.Count instruction@(withContent.Count == 1 ? "" : "s")
                    </span>
                }
                @if (CanEdit)
                {
                    <button class="btn btn-ghost btn-sm instr-edit-btn" @onclick="RequestEdit">✏ Edit</button>
                }
            </div>
        </div>

        @* Inline popover — appears below the chip strip *@
        @if (_openKey is not null)
        {
            var openSec = withContent.FirstOrDefault(s => s.SectionKey == _openKey);
            @if (openSec is not null)
            {
                var isBottom = openSec.Position == InstructionPosition.Bottom;
                <div class="instr-popover @(isBottom ? "instr-popover-bottom" : "instr-popover-top")">
                    <div class="instr-popover-hdr instr-hdr-accent">
                        <span>@openSec.SectionTitle</span>
                        <button class="instr-popover-close" @onclick="() => _openKey = null">✕</button>
                    </div>
                    <div class="instr-popover-body">
                        @foreach (var line in openSec.Lines.Where(l => !l.IsDeleted && !string.IsNullOrWhiteSpace(l.Content)))
                        {
                            <div class="instr-line @(line.IsHighlighted ? "instr-line-urgent" : "")">@line.Content</div>
                        }
                    </div>
                </div>
            }
        }
    }
}

@code {
    [Parameter, EditorRequired] public int                 BranchId      { get; set; }
    [Parameter]                 public InstructionPosition Position      { get; set; } = InstructionPosition.Top;
    /// <summary>When true, shows chips for all positions in one unified strip.</summary>
    [Parameter]                 public bool                AllPositions  { get; set; } = false;
    [Parameter]                 public bool                CanEdit       { get; set; }
    [Parameter]                 public EventCallback       OnEditRequested { get; set; }

    private List<BranchInstructionSectionVm>? _sections;
    private string? _openKey;
    private string? _notifyBanner;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Broadcast.InstructionsUpdated += OnRemoteUpdate;
    }

    public async Task ReloadAsync()
    {
        _openKey = null;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        try
        {
            var vm = await InstructionSvc.GetForBranchAsync(BranchId);
            _sections = AllPositions
                ? vm.Sections.ToList()
                : vm.Sections.Where(s => s.Position == Position).ToList();
        }
        catch
        {
            _sections ??= [];
        }
    }

    private void ToggleSection(string key) =>
        _openKey = _openKey == key ? null : key;

    private async Task RequestEdit() => await OnEditRequested.InvokeAsync();

    private void DismissBanner() => _notifyBanner = null;

    private async Task OnRemoteUpdate(int branchId, string updatedByName)
    {
        if (branchId != BranchId) return;
        await LoadAsync();
        _notifyBanner = updatedByName;
        await InvokeAsync(StateHasChanged);
        _ = Task.Delay(6000).ContinueWith(_ =>
        {
            _notifyBanner = null;
            InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose() => Broadcast.InstructionsUpdated -= OnRemoteUpdate;
}
