@using WreFigDemo.Models.Entities
@inject IScheduleService ScheduleSvc
@inject IAuditService AuditSvc
@inject NoteViewStateService NoteViewState
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="detail-panel">

    @* ── Header ── *@
    <div class="panel-top">
        <button class="panel-close" @onclick="OnClose">&#215;</button>

        <div class="panel-driver-row">
            <div class="driver-avatar">@Initials</div>
            <div class="driver-info">
                <h2>@Row.EmployeeName</h2>
                <p>@Row.DefaultShift shift</p>
            </div>
            <div class="status-badge @(Row.DefaultShift == "PM" ? "pm" : "")">
                Working @Row.DefaultShift
            </div>
        </div>

        <div class="panel-date-block">
            <span class="panel-date-day">@DateLabel</span>
            <div class="panel-date-chip">
                <ShiftChip Code="@Cell?.StatusCode" HasNote="@(Cell?.HasNote ?? false)" />
            </div>
        </div>
    </div>

    @* ── Driver Info ── *@
    <div class="panel-section">
        <div class="panel-section-title">Driver Info</div>
        <div class="info-grid">
            <div class="info-block">
                <label>Truck</label>
                <div class="info-val">
                    @if (Row.TruckAssignment is not null)
                    {
                        @Row.TruckAssignment
                        @if (Row.TruckId is not null)
                        {
                            <span class="info-val-faint"> · @Row.TruckId</span>
                        }
                    }
                    else
                    {
                        <span class="info-val-empty">unassigned</span>
                    }
                </div>
            </div>
            <div class="info-block">
                <label>Shift Window</label>
                <div class="info-val">@ShiftWindow</div>
            </div>
            @if (Row.ManagerName is not null)
            {
                <div class="info-block">
                    <label>Manager</label>
                    <div class="info-val">@Row.ManagerName</div>
                </div>
            }
            @{
                var phone = Row.WorkMobilePhone ?? Row.WorkPhone;
            }
            @if (phone is not null)
            {
                <div class="info-block">
                    <label>Phone</label>
                    <div class="info-val" style="display:flex;align-items:center;gap:10px">
                        <span>@phone</span>
                        <span class="dialpad-link" title="DialPad integration — coming soon">&#128222; DialPad</span>
                    </div>
                </div>
            }
            @if (Row.ResourceTypes.Any())
            {
                <div class="info-block info-block-full">
                    <label>Resource Types</label>
                    <div class="resource-type-chips">
                        @foreach (var rt in Row.ResourceTypes)
                        {
                            <span class="resource-type-chip">@rt</span>
                        }
                    </div>
                </div>
            }
        </div>

        @* Supervisor note *@
        <div class="note-area">
            @if (EditingNote)
            {
                <div class="supervisor-note-box">
                    <div class="note-box-header">
                        <label>Supervisor note</label>
                        <div class="note-actions-inline">
                            <button class="btn btn-ghost btn-sm" @onclick="() => EditingNote = false">Cancel</button>
                            <button class="btn btn-primary btn-sm" @onclick="SaveNote">Save</button>
                        </div>
                    </div>
                    <textarea @bind="NoteText" rows="3" placeholder="Add a note…"></textarea>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(NoteText))
            {
                <div class="supervisor-note-box">
                    <label>Supervisor note</label>
                    <p>@NoteText</p>
                    @if (CanNote)
                    {
                        <button class="btn btn-ghost btn-sm note-edit-btn" @onclick="() => EditingNote = true">Edit note</button>
                    }
                </div>
            }
            else
            {
                <div class="note-empty-row">
                    <span class="note-empty-text">No supervisor note.</span>
                    @if (CanNote)
                    {
                        <button class="btn btn-ghost btn-sm" @onclick="() => EditingNote = true">Add note</button>
                    }
                </div>
            }
        </div>
    </div>

    @* ── Change History ── *@
    <div class="panel-section">
        <div class="panel-section-title">Change History</div>
        @if (LoadingHistory)
        {
            <div class="history-empty">Loading…</div>
        }
        else if (!History.Any())
        {
            <div class="history-empty">No changes recorded for this driver.</div>
        }
        else
        {
            @foreach (var h in History)
            {
                <div class="history-item">
                    <span class="history-dot @h.DotType"></span>
                    <span class="history-text">@h.Text</span>
                    <span class="history-time">@h.TimeAgo</span>
                </div>
            }
        }
    </div>

    @* ── Fleetio ── *@
    <div class="fleetio-row">
        <span class="fleetio-dot"></span>
        <span>Fleetio sync enabled</span>
        <span class="fleetio-link">View in Fleetio ↗</span>
    </div>

</div>

@code {
    [Parameter, EditorRequired] public EmployeeScheduleRow Row  { get; set; } = default!;
    [Parameter, EditorRequired] public int                 Day  { get; set; }
    [Parameter, EditorRequired] public DayCell?            Cell { get; set; }
    [Parameter] public int     Year     { get; set; }
    [Parameter] public int     Month    { get; set; }
    [Parameter] public int     BranchId { get; set; }
    [Parameter] public bool    CanEdit  { get; set; }  // paint / change status
    [Parameter] public bool    CanNote  { get; set; }  // add / edit notes
    [Parameter] public string? UserId   { get; set; }
    [Parameter] public string? UserName { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string? NoteText;
    private bool    EditingNote    = false;
    private bool    LoadingHistory = true;
    private List<HistoryItemVm> History = [];
    private int _loadedEmployeeId;
    private int _loadedDay;

    private string DateLabel   => new DateTime(Year, Month, Day).ToString("dddd, MMMM d");
    private string ShiftWindow => Row.DefaultShift == "PM" ? "12:00 PM – 9:00 PM" : "5:00 AM – 2:30 PM";
    private string Initials    => string.Join("", Row.EmployeeName.Split(' ').Take(2)
                                      .Select(w => w.Length > 0 ? w[0].ToString() : "")).ToUpper();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("registerPanelClickOutside", DotNetObjectReference.Create(this));
    }

    [JSInvokable]
    public async Task OnEscapeKey() => await OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("unregisterPanelClickOutside");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Row.EmployeeId == _loadedEmployeeId && Day == _loadedDay) return;

        _loadedEmployeeId = Row.EmployeeId;
        _loadedDay        = Day;
        EditingNote       = false;

        var date = new DateOnly(Year, Month, Day);
        NoteText = await ScheduleSvc.GetNoteAsync(Row.EmployeeId, date);

        LoadingHistory = true;
        History = await AuditSvc.GetEmployeeHistoryAsync(Row.EmployeeId, date);
        LoadingHistory = false;
    }

    private async Task SaveNote()
    {
        if (UserId is null) return;
        var date = new DateOnly(Year, Month, Day);
        await ScheduleSvc.UpsertNoteAsync(Row.EmployeeId, date, NoteText, UserId, UserName ?? UserId, Cell?.StatusCode);
        EditingNote = false;

        // A new/updated note means it's unviewed again — re-trigger the blink
        NoteViewState.UnmarkCellViewed(Row.EmployeeId, date);
        NoteViewState.UnmarkBranchViewed(BranchId);
    }
}
