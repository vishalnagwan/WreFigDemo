@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <nav class="app-topbar">
                <img src="/images/wre-logo.png" class="topbar-logo-img" alt="Wind River" />

                <div class="topbar-nav">
                    <NavLink href="/" Match="NavLinkMatch.All" class="topbar-nav-link">
                        Home
                    </NavLink>

                    <AuthorizeView Roles="@string.Join(",", AppRoles.ComplianceRoles)">
                        <Authorized Context="_">
                            <NavLink href="/compliance" class="topbar-nav-link">
                                Compliance
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Roles="@string.Join(",", AppRoles.AlertRoles)">
                        <Authorized Context="_">
                            <NavLink href="/alerts" class="topbar-nav-link">
                                Alerts
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Roles="@string.Join(",", AppRoles.RolloverRoles)">
                        <Authorized Context="_">
                            <NavLink href="/rollover" class="topbar-nav-link">
                                Rollover
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>

                    <AuthorizeView Roles="@AppRoles.PlannerDashboard">
                        <Authorized Context="_">
                            <NavLink href="/users" class="topbar-nav-link">
                                Users
                            </NavLink>
                        </Authorized>
                    </AuthorizeView>
                </div>

                <div class="topbar-right">
                    <span class="topbar-user">@(context.User.FindFirst("fullname")?.Value ?? context.User.Identity?.Name)</span>
                    <a href="/Account/Logout" class="btn btn-ghost btn-sm">Sign out</a>
                </div>
            </nav>
        </Authorized>
    </AuthorizeView>
</CascadingAuthenticationState>
